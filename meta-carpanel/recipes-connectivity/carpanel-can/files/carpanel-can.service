[Unit]
Description=SLCAN can0 (STM32 over CP2102)
BindsTo=dev-serial-by\x2did-usb\x2dSilicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001\x2dif00\x2dport0.device
After=dev-serial-by\x2did-usb\x2dSilicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001\x2dif00\x2dport0.device

[Service]
Type=forking
ExecStart=/usr/bin/slcand -o -c -s6 -S 115200 /dev/serial/by-id/usb-Silicon_Labs_CP2102_USB_to_UART_Bridge_Controller_0001-if00-port0 can0
ExecStartPost=/sbin/ip link set can0 up

[Install]
WantedBy=multi-user.target
